{
  "_comment": "Convergence-threshold discovery beats for hollow_season. Mirrors amber_cipher / resonance_test schema. The case-specific emotional_geography beat fires once the motive dim crosses 0.7 and the player is past turn 18 — it represents the late-game pivot that breaks the Finch false plateau: the motive that had been audit-exposure becomes the motive that had been the house. The case is rated medium mechanically; verdict_ready waits to turn 26 because the bridge token (the chemist's receipt in the wastepaper basket) is structurally late.",
  "schema_version": 1,
  "case_id": "hollow_season",

  "convergence_dim_names": ["suspect", "evidence", "motive"],

  "beats": [
    {
      "id": "first_thread",
      "trigger": { "any_dim_gte": 0.4 },
      "min_turn": 6,
      "fire_once": true,
      "inject": { "REVELATION": "revelation:contradiction_surfaces" }
    },
    {
      "id": "false_plateau_finch",
      "trigger": { "dim": "suspect", "gte": 0.55 },
      "min_turn": 10,
      "fire_once": true,
      "inject": { "REVELATION": "revelation:partial_match" }
    },
    {
      "id": "name_surfaces",
      "trigger": { "dim": "suspect", "gte": 0.6 },
      "min_turn": 14,
      "fire_once": true,
      "inject": { "REVELATION": "revelation:name_uncovered" }
    },
    {
      "id": "motive_emerges",
      "trigger": { "dim": "motive", "gte": 0.6 },
      "min_turn": 16,
      "fire_once": true,
      "inject": { "REVELATION": "revelation:motive_emerges" }
    },
    {
      "id": "emotional_geography",
      "trigger": { "dim": "motive", "gte": 0.7 },
      "min_turn": 20,
      "fire_once": true,
      "inject": { "REVELATION": "revelation:emotional_geography_lands" }
    },
    {
      "id": "closing_in",
      "trigger": { "min_dim_gte": 0.65 },
      "min_turn": 22,
      "fire_once": true,
      "inject": { "BEAT": "beat:closing_in" }
    },
    {
      "id": "verdict_ready",
      "trigger": { "min_dim_gte": 0.8 },
      "min_turn": 26,
      "fire_once": true,
      "inject": { "BEAT": "beat:verdict_ready" }
    }
  ]
}
