{
  "_comment": "Convergence-threshold discovery beats for The Tidal Interval. Mirrors the amber_cipher / attended_hour schema, with one extra case-specific beat that fires the tidal_window_identified revelation as soon as the evidence convergence dim crosses a moderate threshold — the case's structural clock is its closing-arc weapon. Each beat fires at most once per session.",
  "schema_version": 1,
  "case_id": "tidal_interval",

  "convergence_dim_names": ["suspect", "evidence", "motive"],

  "beats": [
    {
      "id": "first_thread",
      "trigger": { "any_dim_gte": 0.4 },
      "min_turn": 6,
      "fire_once": true,
      "inject": { "REVELATION": "revelation:contradiction_surfaces" }
    },
    {
      "id": "tidal_window_identified",
      "trigger": { "dim": "evidence", "gte": 0.5 },
      "min_turn": 10,
      "fire_once": true,
      "inject": { "REVELATION": "revelation:tidal_window_identified" }
    },
    {
      "id": "name_surfaces",
      "trigger": { "dim": "suspect", "gte": 0.6 },
      "min_turn": 12,
      "fire_once": true,
      "inject": { "REVELATION": "revelation:name_uncovered" }
    },
    {
      "id": "motive_emerges",
      "trigger": { "dim": "motive", "gte": 0.6 },
      "min_turn": 14,
      "fire_once": true,
      "inject": { "REVELATION": "revelation:motive_emerges" }
    },
    {
      "id": "closing_in",
      "trigger": { "min_dim_gte": 0.65 },
      "min_turn": 18,
      "fire_once": true,
      "inject": { "BEAT": "beat:closing_in" }
    },
    {
      "id": "verdict_ready",
      "trigger": { "min_dim_gte": 0.8 },
      "min_turn": 24,
      "fire_once": true,
      "inject": { "BEAT": "beat:verdict_ready" }
    }
  ]
}
