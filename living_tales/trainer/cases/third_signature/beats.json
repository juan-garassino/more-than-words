{
  "_comment": "Convergence-threshold discovery beats for third_signature. Mirrors amber_cipher / attended_hour / venetian_mirror schema with case-appropriate revelation tokens. Closing-arc scaffolding for thin-trajectory training; once the BEAT and SIGNATURE_TELL heads learn to fire on their own, these thresholds can be lowered or removed. The case-specific third_signatory_break beat is the structural payoff — when the suspect dim and the evidence dim both pass the threshold late, the runtime forces a name_uncovered revelation paired with the third-signatory SIGNATURE_TELL, which is the case's pivot.",
  "schema_version": 1,
  "case_id": "third_signature",

  "convergence_dim_names": ["suspect", "evidence", "motive"],

  "beats": [
    {
      "id": "first_thread",
      "trigger": { "any_dim_gte": 0.4 },
      "min_turn": 6,
      "fire_once": true,
      "inject": { "REVELATION": "revelation:contradiction_surfaces" }
    },
    {
      "id": "register_mismatch",
      "trigger": { "dim": "evidence", "gte": 0.5 },
      "min_turn": 10,
      "fire_once": true,
      "inject": { "REVELATION": "revelation:partial_match", "SIGNATURE_TELL": "signature_tell:leftward_slope" }
    },
    {
      "id": "name_surfaces",
      "trigger": { "dim": "suspect", "gte": 0.6 },
      "min_turn": 12,
      "fire_once": true,
      "inject": { "REVELATION": "revelation:name_uncovered" }
    },
    {
      "id": "motive_emerges",
      "trigger": { "dim": "motive", "gte": 0.6 },
      "min_turn": 14,
      "fire_once": true,
      "inject": { "REVELATION": "revelation:motive_emerges" }
    },
    {
      "id": "third_signatory_break",
      "trigger": { "all_dims_gte": [["suspect", 0.65], ["evidence", 0.65]] },
      "min_turn": 16,
      "fire_once": true,
      "inject": { "SIGNATURE_TELL": "signature_tell:third_signatory_revealed", "REVELATION": "revelation:confirmation" }
    },
    {
      "id": "closing_in",
      "trigger": { "min_dim_gte": 0.65 },
      "min_turn": 18,
      "fire_once": true,
      "inject": { "BEAT": "beat:closing_in" }
    },
    {
      "id": "verdict_ready",
      "trigger": { "min_dim_gte": 0.8 },
      "min_turn": 24,
      "fire_once": true,
      "inject": { "BEAT": "beat:verdict_ready" }
    }
  ]
}
