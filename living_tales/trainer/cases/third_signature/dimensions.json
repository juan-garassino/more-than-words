        "signature_tell:leftward_slope",
        "signature_tell:nib_pressure_match",
        "signature_tell:margin_correction",
        "signature_tell:dedication_match",
        "signature_tell:third_signatory_revealed",
        "signature_tell:typescript_correction",
        "signature_tell:authenticity_holds",
        "signature_tell:none"
      ]
    }
