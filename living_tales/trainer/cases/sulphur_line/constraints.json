{
  "schema_version": 1,
  "case_id": "sulphur_line",

  "_comment": "Hard-mask rules for sulphur_line. Same universal scaffolding as amber_cipher / hollow_season / third_signature, plus case-specific rules covering INDUSTRIAL_TELL and the case's mechanical signal cluster (the maintenance-log revision + the three-day gap + the canal-bend evidence + the sulphur trace on the coat). At inference, any logit violating an applicable rule is set to -inf BEFORE softmax. Rules are evaluated in dim emission order. Special predicates start with `@`.",

  "rules": [

    {
      "id": "transition_stayed_implies_same_location",
      "if": {"TRANSITION": "transition:stayed"},
      "then": {"LOCATION": "@equals_previous_scene_location"}
    },
    {
      "id": "transition_crossed_implies_different_location",
      "if": {"TRANSITION": "transition:crossed_to"},
      "then": {"LOCATION": "@differs_from_previous_scene_location"}
    },
    {
      "id": "transition_returned_implies_visited_location",
      "if": {"TRANSITION": "transition:returned"},
      "then": {"LOCATION": "@in_visited_locations"}
    },
    {
      "id": "transition_none_only_first_scene",
      "if": {"TRANSITION": "transition:none"},
      "then": {"@scene_index_eq": 0}
    },

    {
      "id": "presence_alone_no_stance",
      "if": {"PRESENCE": "presence:alone"},
      "then": {"STANCE": "stance:none", "TELL": "tell:none"}
    },
    {
      "id": "presence_someone_requires_stance",
      "if": {"PRESENCE": "@not_alone"},
      "then": {"STANCE": "@not_in", "values": ["stance:none"]}
    },

    {
      "id": "stance_hostile_requires_visible_tell",
      "if": {"STANCE": "stance:hostile"},
      "then": {"TELL": "@in", "values": [
        "tell:paled", "tell:tightened", "tell:silent",
        "tell:glanced_aside", "emotion:closed_posture"
      ]}
    },
    {
      "id": "stance_evasive_implies_softer_tells",
      "if": {"STANCE": "stance:evasive"},
      "then": {"TELL": "@in", "values": [
        "tell:hesitated", "tell:glanced_aside", "tell:over_explained",
        "emotion:paused_reply", "emotion:closed_posture",
        "emotion:practised_account", "emotion:bargained_silence", "tell:none"
      ]}
    },

    {
      "id": "revelation_contradiction_requires_inconsistency_cause",
      "if": {"REVELATION": "revelation:contradiction_surfaces"},
      "then": {"CAUSE": "cause:noticed_inconsistency"}
    },
    {
      "id": "revelation_name_uncovered_requires_evidence",
      "if": {"REVELATION": "revelation:name_uncovered"},
      "then": {"OBJECT_FOCUS": "@not_in", "values": ["object_focus:none"]}
    },
    {
      "id": "revelation_name_gated_by_convergence",
      "if": {"REVELATION": "revelation:name_uncovered"},
      "then": {"@convergence_min_gte": 0.5}
    },
    {
      "id": "revelation_motive_gated_by_convergence",
      "if": {"REVELATION": "revelation:motive_emerges"},
      "then": {"@convergence_min_gte": 0.5}
    },
    {
      "id": "revelation_shadow_of_gap_gated",
      "if": {"REVELATION": "revelation:shadow_of_gap_lands"},
      "then": {"@convergence_min_gte": 0.6}
    },
    {
      "id": "revelation_alibi_requires_witness",
      "if": {"REVELATION": "revelation:alibi_holds"},
      "then": {"PRESENCE": "@is_witness_or_suspect"}
    },

    {
      "id": "beat_closing_in_gated",
      "if": {"BEAT": "beat:closing_in"},
      "then": {"@convergence_min_gte": 0.5}
    },
    {
      "id": "beat_verdict_ready_gated",
      "if": {"BEAT": "beat:verdict_ready"},
      "then": {"@convergence_min_gte": 0.75}
    },
    {
      "id": "beat_orientation_only_early",
      "if": {"BEAT": "beat:orientation"},
      "then": {"@convergence_min_lt": 0.25}
    },

    {
      "id": "action_confronts_requires_present_npc",
      "if": {"ACTION": "action:confronts"},
      "then": {"PRESENCE": "@not_alone"}
    },
    {
      "id": "action_questions_requires_present_npc",
      "if": {"ACTION": "action:questions"},
      "then": {"PRESENCE": "@not_alone"}
    },
    {
      "id": "action_examines_requires_object",
      "if": {"ACTION": "action:examines"},
      "then": {"OBJECT_FOCUS": "@not_in", "values": ["object_focus:none"]}
    },
    {
      "id": "action_cross_references_requires_object",
      "if": {"ACTION": "action:cross_references"},
      "then": {"OBJECT_FOCUS": "@not_in", "values": ["object_focus:none"]}
    },
    {
      "id": "action_arrives_requires_transition",
      "if": {"ACTION": "action:arrives"},
      "then": {"TRANSITION": "@in", "values": [
        "transition:crossed_to", "transition:entered",
        "transition:returned", "transition:pursued_to",
        "transition:descended_to"
      ]}
    },

    {
      "id": "atmosphere_dawn_only_late_game",
      "if": {"ATMOSPHERE": "atmosphere:dawn_approaches"},
      "then": {"@turn_gte": 40}
    },
    {
      "id": "atmosphere_sulphur_smell_requires_works_locations",
      "if": {"ATMOSPHERE": "atmosphere:sulphur_smell_drifts"},
      "then": {"LOCATION": "@in", "values": [
        "location:works_yard", "location:processing_line",
        "location:sulphur_store", "location:foreman_station",
        "location:canal_path", "location:workers_lockers",
        "location:dispatch_office", "location:works_gate"
      ]}
    },
    {
      "id": "atmosphere_works_whistle_requires_works_locations",
      "if": {"ATMOSPHERE": "atmosphere:works_whistle"},
      "then": {"LOCATION": "@in", "values": [
        "location:works_yard", "location:processing_line",
        "location:sulphur_store", "location:foreman_station",
        "location:workers_lockers", "location:dispatch_office",
        "location:works_gate", "location:canal_path"
      ]}
    },

    {
      "id": "cause_summoned_requires_npc",
      "if": {"CAUSE": "cause:summoned"},
      "then": {"PRESENCE": "@not_alone"}
    },
    {
      "id": "cause_following_lead_requires_recent_witness",
      "if": {"CAUSE": "cause:following_witness_lead"},
      "then": {"@last_player_token_class_in": ["WITNESS", "SUSPECT"]}
    },
    {
      "id": "cause_recognized_object_requires_recent_object",
      "if": {"CAUSE": "cause:recognized_object"},
      "then": {"@last_player_token_class_in": ["OBJECT", "MODIFIER"]}
    },
    {
      "id": "cause_reading_maintenance_log_requires_log_object",
      "if": {"CAUSE": "cause:reading_maintenance_log"},
      "then": {"OBJECT_FOCUS": "@in", "values": [
        "object:maintenance_log", "object:accident_log",
        "object:revised_entry", "object:dispatch_ledger"
      ]}
    },
    {
      "id": "cause_tracing_log_revision_requires_industrial_tell",
      "if": {"CAUSE": "cause:tracing_log_revision"},
      "then": {"INDUSTRIAL_TELL": "@not_in", "values": [
        "industrial_tell:none", "industrial_tell:safety_record_holds"
      ]}
    },

    {
      "id": "industrial_tell_log_revised_requires_log_object",
      "if": {"INDUSTRIAL_TELL": "industrial_tell:log_entry_revised"},
      "then": {"OBJECT_FOCUS": "@in", "values": [
        "object:maintenance_log", "object:accident_log",
        "object:revised_entry", "object:dispatch_ledger"
      ]}
    },
    {
      "id": "industrial_tell_ink_does_not_match_requires_log_object",
      "if": {"INDUSTRIAL_TELL": "industrial_tell:ink_does_not_match"},
      "then": {"OBJECT_FOCUS": "@in", "values": [
        "object:maintenance_log", "object:accident_log",
        "object:revised_entry", "object:dispatch_ledger"
      ]}
    },
    {
      "id": "industrial_tell_hand_does_not_match_requires_log_object",
      "if": {"INDUSTRIAL_TELL": "industrial_tell:hand_does_not_match"},
      "then": {"OBJECT_FOCUS": "@in", "values": [
        "object:maintenance_log", "object:accident_log",
        "object:revised_entry", "object:dispatch_ledger"
      ]}
    },
    {
      "id": "industrial_tell_three_day_gap_requires_accident_log",
      "if": {"INDUSTRIAL_TELL": "industrial_tell:three_day_gap"},
      "then": {"OBJECT_FOCUS": "@in", "values": [
        "object:accident_log", "object:maintenance_log", "object:revised_entry"
      ]}
    },
    {
      "id": "industrial_tell_shadow_of_gap_gated",
      "if": {"INDUSTRIAL_TELL": "industrial_tell:shadow_of_gap"},
      "then": {"@convergence_min_gte": 0.6}
    },
    {
      "id": "industrial_tell_button_at_bend_requires_canal_or_object",
      "if": {"INDUSTRIAL_TELL": "industrial_tell:button_at_bend"},
      "then": {"LOCATION": "@in", "values": [
        "location:canal_path", "location:foreman_station",
        "location:oake_office", "location:dispatch_office"
      ]}
    },
    {
      "id": "industrial_tell_shoe_prints_paired_requires_canal_or_yard",
      "if": {"INDUSTRIAL_TELL": "industrial_tell:shoe_prints_paired"},
      "then": {"LOCATION": "@in", "values": [
        "location:canal_path", "location:works_yard", "location:works_gate"
      ]}
    },
    {
      "id": "industrial_tell_sulphur_on_coat_requires_npc_or_locker",
      "if": {"INDUSTRIAL_TELL": "industrial_tell:sulphur_on_coat"},
      "then": {"LOCATION": "@in", "values": [
        "location:oake_house", "location:oake_office",
        "location:workers_lockers", "location:foreman_station"
      ]}
    },
    {
      "id": "industrial_tell_scales_mismatch_requires_dispatch",
      "if": {"INDUSTRIAL_TELL": "industrial_tell:scales_mismatch_ledger"},
      "then": {"OBJECT_FOCUS": "@in", "values": [
        "object:dispatch_ledger", "object:sulphur_scales", "object:sample_receipt"
      ]}
    }

  ],

  "_predicates_comment": "Reference for the predicate runtime. The constraint compiler resolves each `@predicate` against the current GameState to produce a concrete boolean mask over the dim's vocabulary at sample time.",
  "_predicates": {
    "@equals_previous_scene_location": "LOCATION must equal the location of the most recent scene where LOCATION != none",
    "@differs_from_previous_scene_location": "LOCATION must differ from the most recent scene's LOCATION (and not be `location:none`)",
    "@in_visited_locations": "LOCATION must be one previously visited (in dialogue_history)",
    "@scene_index_eq": "current scene index must equal value",
    "@not_alone": "PRESENCE must not be `presence:alone`",
    "@is_witness_or_suspect": "PRESENCE must be a `with_<witness|suspect>:*`",
    "@convergence_min_gte": "min(convergence_dims) must be >= value",
    "@convergence_min_lt": "min(convergence_dims) must be < value",
    "@turn_gte": "current game_turn must be >= value",
    "@last_player_token_class_in": "the player's most recent card belongs to one of these legacy classes",
    "@in": "the dim's value must be in the supplied `values` list",
    "@not_in": "the dim's value must NOT be in the supplied `values` list"
  }
}
