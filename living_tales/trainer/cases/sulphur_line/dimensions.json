      "case_specific": true,
      "_comment": "Chemical/industrial observables — the case's precise physical evidence. INDUSTRIAL_TELL fires when the detective is inspecting written or material traces left by the works: the maintenance-log entries overwritten in slightly different ink and slightly different handwriting (not a forgery — a revision); the three-day gap in the accident log from September 1886; the shadow-of-gap (a reference in an earlier entry to a note that should have followed it and did not); the canal-bank shoe-prints at the bend; the button found in the gravel; the smell of sulphur on a coat that was meant to have stayed home with the wife; the dispatch ledger arrivals that do not match what the scales say was weighed. log_entry_revised is the central one — Gould knew the difference between a correction made at the time and a correction made later. shadow_of_gap is the LATE-phase pivot that closes the case onto Oake.",
      "gated_by_convergence": {
        "industrial_tell:log_entry_revised": 0.4,
        "industrial_tell:shadow_of_gap": 0.6,
        "industrial_tell:button_at_bend": 0.5,
        "industrial_tell:sulphur_on_coat": 0.5
      },
      "vocab": [
        "industrial_tell:log_entry_revised",
        "industrial_tell:ink_does_not_match",
        "industrial_tell:hand_does_not_match",
        "industrial_tell:three_day_gap",
        "industrial_tell:shadow_of_gap",
        "industrial_tell:button_at_bend",
        "industrial_tell:shoe_prints_paired",
        "industrial_tell:sulphur_on_coat",
        "industrial_tell:scales_mismatch_ledger",
        "industrial_tell:safety_record_holds",
        "industrial_tell:none"
      ]
    }
